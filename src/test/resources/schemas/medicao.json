{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Medicao de sensor urbano",
  "type": "object",
  "required": [
    "_id",
    "equipamento_id",
    "tipo",
    "data",
    "competencia",
    "leitura"
  ],
  "properties": {
    "_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{24}$"
    },
    "equipamento_id": {
      "type": "string",
      "pattern": "^EQP-[A-Z]{3}-[0-9]{3}$"
    },
    "tipo": {
      "enum": [
        "qualidade_ar",
        "ruido",
        "energia",
        "agua",
        "trafego",
        "hidrologia"
      ]
    },
    "data": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "competencia": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}$"
    },
    "sensor": {
      "type": "object"
    },
    "leitura": {
      "type": "object",
      "minProperties": 1
    },
    "referencia": {
      "type": "object"
    },
    "alerta": {
      "type": "object",
      "description": "So existe quando uma regra de alerta disparou.",
      "required": [
        "nivel",
        "regra",
        "disparado_em",
        "reconhecido"
      ],
      "properties": {
        "nivel": {
          "enum": [
            "critico",
            "alto",
            "medio"
          ]
        },
        "regra": {
          "type": "string",
          "minLength": 3
        },
        "disparado_em": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
        },
        "reconhecido": {
          "type": "boolean"
        }
      }
    }
  }
}

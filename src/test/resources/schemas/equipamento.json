{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Equipamento publico do municipio",
  "description": "Campos obrigatorios fixos; atributos especificos de cada tipo sao livres (esquema flexivel).",
  "type": "object",
  "required": [
    "_id",
    "codigo",
    "nome",
    "tipo",
    "distrito",
    "ativo",
    "criado_em"
  ],
  "properties": {
    "_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{24}$"
    },
    "codigo": {
      "type": "string",
      "pattern": "^EQP-[A-Z]{3}-[0-9]{3}$"
    },
    "nome": {
      "type": "string",
      "minLength": 3
    },
    "tipo": {
      "enum": [
        "escola",
        "saude",
        "praca",
        "saneamento",
        "iluminacao",
        "ecoponto",
        "terminal"
      ]
    },
    "distrito": {
      "type": "string",
      "minLength": 3
    },
    "ativo": {
      "type": "boolean"
    },
    "populacao_atendida": {
      "type": "integer",
      "minimum": 0
    },
    "criado_em": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "atualizado_em": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "desativado_em": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "metas_esg": {
      "type": "object"
    },
    "local": {
      "type": "object",
      "required": [
        "type",
        "coordinates"
      ],
      "properties": {
        "type": {
          "enum": [
            "Point"
          ]
        },
        "coordinates": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        }
      }
    }
  }
}

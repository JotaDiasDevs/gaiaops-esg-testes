{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Coleta de residuos",
  "type": "object",
  "required": [
    "_id",
    "categoria",
    "data_coleta",
    "peso_kg",
    "destinacao"
  ],
  "properties": {
    "_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{24}$"
    },
    "categoria": {
      "enum": [
        "reciclavel",
        "organico",
        "rejeito",
        "eletronico",
        "saude",
        "construcao"
      ]
    },
    "data_coleta": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "peso_kg": {
      "type": "number",
      "minimum": 0
    },
    "destinacao": {
      "type": "object",
      "required": [
        "tipo"
      ],
      "properties": {
        "tipo": {
          "type": "string",
          "minLength": 3
        }
      }
    }
  }
}
